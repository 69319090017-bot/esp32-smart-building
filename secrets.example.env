# SMART BUILDING COMMAND CENTER - CENTRAL SECRETS VAULT TEMPLATE (2026)
# ==============================================================
# INSTRUCTIONS:
# 1. Copy this file to `secrets.env` (which is git-ignored).
# 2. Fill in your actual credentials below.
# 3. Run `py setup_secrets.py` to distribute values to ESP32, Telegram Bot, and Web.
# ==============================================================

# ---------------------------------------------------------
# 1. WiFi Settings (For Real ESP32 Hardware - 2.4GHz Only)
# ---------------------------------------------------------
WIFI_SSID=your_wifi_2.4g_name
WIFI_PASSWORD=your_wifi_password

# ---------------------------------------------------------
# 2. Telegram Bot Settings (Real-time Mobile Disaster Dispatch)
# ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=8867483532:AAEDORtuSDLfOjGkDPXf9GqeXTLwltduqxw
TELEGRAM_CHAT_ID=-5358266072

# ---------------------------------------------------------
# 3. MQTT Broker Settings (Building Automation / Relays)
# ---------------------------------------------------------
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883

# ---------------------------------------------------------
# 4. Device Identity
# ---------------------------------------------------------
DEVICE_ID=smart_building_001

# ---------------------------------------------------------
# 5. Firebase Cloud Project Settings (Optional / Real-time Sync)
# ---------------------------------------------------------
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app/
FIREBASE_API_KEY=AIzaSyYourProjectWebApiKeyHere
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ---------------------------------------------------------
# 6. Firebase Authentication (Service Users)
# ---------------------------------------------------------
ESP32_AUTH_EMAIL=esp32-building@yourdomain.com
ESP32_AUTH_PASSWORD=YourStrongDevicePassword123!
BOT_AUTH_EMAIL=admin-bot@yourdomain.com
BOT_AUTH_PASSWORD=YourStrongAdminPassword123!
