# ---------------------------------------------------------
# Discord Webhook & Bot Settings
# ---------------------------------------------------------
# The URL for your Discord channel's webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# The Bot Token for interactive slash commands
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ---------------------------------------------------------
# Firebase Settings
# ---------------------------------------------------------
# Your Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com/

# The ESP32 and this service should use separate restricted Firebase Auth users.
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_EMAIL=discord-bot@example.com
FIREBASE_AUTH_PASSWORD=a_long_unique_password
DEVICE_ID=garage_001

# Optional for short development sessions only. Use the Auth credentials above
# in production so the service can renew its own short-lived token.
# FIREBASE_ID_TOKEN=

# ---------------------------------------------------------
# Server Settings
# ---------------------------------------------------------
# Port for the health check web server (useful for platforms like Render)
PORT=8080
